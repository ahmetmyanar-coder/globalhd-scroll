{
 "headers": [
  {
   "source": "/assets/fonts/(.*)",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "public, max-age=31536000, immutable"
    }
   ]
  },
  {
   "source": "/assets/(saha-web|seq-web|kurum)/(.*)",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "public, max-age=3600, stale-while-revalidate=86400"
    }
   ]
  }
 ]
}
